          "id": "154e811d-89dc-493a-8bbf-e7ef156f7836",
          "name": "Authenticate and Get Access Token",
          "request": {
            "name": "Authenticate and Get Access Token",
            "description": {
              "content": "Exchange API credentials for a Bearer access token. The token is valid for 3600 seconds (60 minutes). A refresh token valid for 7 days is also returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "api"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<string>\",\n  \"password\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "f4994765-666d-427a-85c4-82b979fdc73a",
              "name": "Authentication successful",
              "originalRequest": {
                "url": {
