          "name": "Link Entity to Canonical Identifier",
          "request": {
            "name": "Link Entity to Canonical Identifier",
            "description": {
              "content": "Resolves one or more entity mentions to their canonical Kensho Entity Identifier (KEID). Accepts entity names, aliases, ticker symbols, CUSIP, ISIN, or other identifiers and returns the canonical entity record.",
